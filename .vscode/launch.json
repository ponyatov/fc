            "type"         : "cppdbg",
            "request"      : "launch",
            "program"      : "${command:cmake.launchTargetPath}",
            "preLaunchTask": "CMake: build",
            "cwd"          : "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
