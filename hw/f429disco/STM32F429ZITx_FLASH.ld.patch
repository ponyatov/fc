 /* Entry Point */
 ENTRY(Reset_Handler)
 
 /* Highest address of the user mode stack */
-_estack = ORIGIN() + LENGTH();    /* end of RAM */
+_estack = ORIGIN(RAM) + LENGTH(RAM);            /* end of RAM */
 /* Generate a link error if heap and stack don't fit into RAM */
-_Min_Heap_Size = 0x200;      /* required amount of heap  */
-_Min_Stack_Size = 0x400; /* required amount of stack */
+_Min_Heap_Size  = 0x200;          /* required amount of heap  */
+_Min_Stack_Size = 0x400;          /* required amount of stack */
 
 /* Specify the memory areas */
 MEMORY
 {
-RAM (xrw)      : ORIGIN = 0x20000000, LENGTH = 192K
-CCMRAM (xrw)      : ORIGIN = 0x10000000, LENGTH = 64K
-FLASH (rx)      : ORIGIN = 0x8000000, LENGTH = 2048K
+FLASH  (r x) : ORIGIN =  0x8000000, LENGTH =    2M
+RAM    (rwx) : ORIGIN = 0x20000000, LENGTH =  192K
+CCM    (rwx) : ORIGIN = 0x10000000, LENGTH =   64K
+XRAM   (rwx) : ORIGIN = 0xD0000000, LENGTH =    8M
 }
 
 /* Define output sections */
@@ -144,9 +101,9 @@
 
     . = ALIGN(4);
     _edata = .;        /* define a global symbol at data end */
-  } > AT> FLASH
+  } > RAM AT> FLASH
 
-  _siccmram = LOADADDR(.ccmram);
+  _siccm = LOADADDR(.ccm);
 
   /* CCM-RAM section 
   * 
@@ -154,17 +111,16 @@
   * If initialized variables will be placed in this section,
   * the startup code needs to be modified to copy the init-values.  
   */
-  .ccmram :
+  .ccm :
   {
     . = ALIGN(4);
-    _sccmram = .;       /* create a global symbol at ccmram start */
-    *(.ccmram)
-    *(.ccmram*)
+    _sccm = .;       /* create a global symbol at ccmram start */
+    *(.ccm)
+    *(.ccm*)
     
     . = ALIGN(4);
-    _eccmram = .;       /* create a global symbol at ccmram end */
-  } >CCMRAM AT> FLASH
-
+    _eccm = .;       /* create a global symbol at ccmram end */
+  } >CCM AT> FLASH
   
   /* Uninitialized data section */
   . = ALIGN(4);
@@ -180,7 +136,7 @@
     . = ALIGN(4);
     _ebss = .;         /* define a global symbol at bss end */
     __bss_end__ = _ebss;
-  } >
+  } > RAM
 
   /* User_heap_stack section, used to check that there is enough RAM left */
   ._user_heap_stack :
@@ -191,18 +147,26 @@
     . = . + _Min_Heap_Size;
     . = . + _Min_Stack_Size;
     . = ALIGN(8);
-  } >
+  } > RAM
 
-  
+  _sixram = LOADADDR(.xram);
+
+  /* External RAM section */
+  .xram :
+  {
+    . = ALIGN(0x10);
+    _sxram = .;       /* create a global symbol at xram start */
+    KEEP (*(.xram ))
+    KEEP (*(.xram*))
+    . = ALIGN(0x10);
+    _exram = .;       /* create a global symbol at xram end */
+  } > XRAM AT> FLASH
 
   /* Remove information from the standard libraries */
   /DISCARD/ :
   {
-    libc.a ( * )
-    libm.a ( * )
